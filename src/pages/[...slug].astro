---
// Ported from genai/src/routes/$.tsx (splat category route). One static page
// per category, one per language with enough art, and one picture page per
// live gallery image at /<category>/<image-slug>/.
import Layout from '../layouts/Layout.astro';
import SocialImage from '../components/SocialImage.astro';
import { CategoryPage, PicturePage } from '../components/pics/experience';
import { categories, catalog, type Category, type Picture } from '../lib/pics';
import { galleryFor } from '../lib/gallery-data';
import { assertNoPathCollisions, catalogPictures, imagePath, jpegPath, languagePages, languagePath, pageTitle, parentCategory, relatedPictures, LANGUAGES, SITE, type Language } from '../lib/catalog';

export function getStaticPaths() {
  assertNoPathCollisions();
  const categoryPages = categories.map((category) => ({ params: { slug: category.slug }, props: { kind: 'category' as const, category } }));
  const picturePages = catalogPictures.map((entry) => {
    const picture = catalog.find((p) => p.id === entry.id)!;
    const category = categories.find((c) => c.slug === entry.category)!;
    const related = relatedPictures(entry).map((r) => catalog.find((p) => p.id === r.id)!);
    return { params: { slug: `${entry.category}/${entry.slug}` }, props: { kind: 'picture' as const, category, picture, related } };
  });
  const languagePageList = categories.flatMap((category) => languagePages(category.slug).map((language) => ({
    params: { slug: `${category.slug}/${LANGUAGES[language].slug}` }, props: { kind: 'language' as const, category, language },
  })));
  return [...categoryPages, ...languagePageList, ...picturePages];
}

type Props =
  | { kind: 'category'; category: Category }
  | { kind: 'language'; category: Category; language: Language }
  | { kind: 'picture'; category: Category; picture: Picture; related: Picture[] };
const props = Astro.props as Props;
const { category } = props;
const gallery = galleryFor(category.slug).filter((p) => props.kind !== 'language' || p.language === props.language);
const lead = props.kind === 'picture' ? props.picture : gallery[0];
const canonical = props.kind === 'picture' ? `${SITE}/${category.slug}/${props.picture.slug}/`
  : props.kind === 'language' ? SITE + languagePath(category.slug, props.language)
  : `${SITE}/${category.slug}/`;
const heading = props.kind === 'picture' ? props.picture.h1!
  : props.kind === 'language' ? `${category.h1} in ${LANGUAGES[props.language].name}`
  : category.h1;
const title = pageTitle(props.kind === 'picture' ? props.picture.h1!
  : props.kind === 'language' ? `${category.h1} in ${LANGUAGES[props.language].name}`
  : category.title);
const description = props.kind === 'picture' ? props.picture.description!
  : props.kind === 'language' ? `${category.h1} in ${LANGUAGES[props.language].name}. ${category.description}`
  : category.description;
const ogImage = lead?.slug ? jpegPath({ category: lead.category, slug: lead.slug }) : category.image;
const ogAlt = lead?.alt ?? category.name;
// No live art yet → thin page: keep it out of the index until it has some.
const noindex = props.kind === 'category' && galleryFor(category.slug).length === 0;

// Breadcrumb: Home → parent hub (if any) → category → picture. Mirrors the visible trail.
const parent = parentCategory(category.slug);
const trail = [
  { name: 'Home', item: `${SITE}/` },
  ...(parent ? [{ name: parent.name, item: `${SITE}/${parent.slug}/` }] : []),
  { name: category.name, item: `${SITE}/${category.slug}/` },
  ...(props.kind === 'language' ? [{ name: LANGUAGES[props.language].name, item: canonical }] : []),
  ...(props.kind === 'picture' ? [{ name: props.picture.title, item: canonical }] : []),
];
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, item: t.item })),
};
// FAQ is only rendered on the main category page, so only marked up there.
const faq = props.kind === 'category' ? category.faq : [];
const graph = props.kind === 'picture' ? [
  {
    '@type': 'ImageObject',
    '@id': `${canonical}#image`,
    contentUrl: new URL(props.picture.file!, SITE).href,
    url: canonical,
    name: heading,
    caption: props.picture.caption ?? props.picture.title,
    description: props.picture.alt,
    width: 1080,
    height: 1080,
    encodingFormat: 'image/webp',
    inLanguage: props.picture.language,
    representativeOfPage: true,
    creditText: 'LaMill Pics',
  },
  breadcrumb,
] : [
  {
    '@type': 'CollectionPage',
    '@id': `${canonical}#collection`,
    url: canonical,
    name: heading,
    description,
    inLanguage: [...new Set(gallery.map((p) => p.language).filter(Boolean))],
    isPartOf: { '@id': `${SITE}/#website` },
    ...(gallery.length ? { image: gallery.map((p) => new URL(imagePath({ category: p.category, slug: p.slug! }), SITE).href) } : {}),
  },
  breadcrumb,
  ...(faq.length ? [{
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  }] : []),
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <SocialImage src={ogImage} alt={ogAlt} width={lead?.slug ? 1080 : undefined} height={lead?.slug ? 1080 : undefined} />
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  {props.kind === 'picture'
    ? <PicturePage client:load picture={props.picture} category={category} related={props.related} url={canonical} jpeg={jpegPath({ category: category.slug, slug: props.picture.slug! })} />
    : <CategoryPage client:load category={category} language={props.kind === 'language' ? props.language : undefined} />}
</Layout>
