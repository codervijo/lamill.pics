---
// Shared document shell (ported from genai/src/routes/__root.tsx RootShell +
// root head). Per-page SEO tags (title, description, canonical, OG, JSON-LD)
// are passed in via the "head" slot so each page owns its own metadata.
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta property="og:site_name" content="LaMill Pics" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700;750&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Noto+Sans+Malayalam:wght@400;500&family=Noto+Sans+Arabic:wght@400;500&display=swap" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
